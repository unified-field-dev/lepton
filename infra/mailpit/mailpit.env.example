# Host wiring only — load in the smoke script or host boot, not inside library send paths.
UF_EMAIL_DRIVER=smtp
UF_SMTP_HOST=127.0.0.1
UF_SMTP_PORT=1025
UF_SMTP_USE_TLS=false
# leave UF_SMTP_USERNAME / UF_SMTP_PASSWORD unset for Mailpit
UF_EMAIL_FROM=noreply@example.test
UF_EMAIL_FROM_NAME=Lepton Auth
UF_PUBLIC_BASE_URL=http://127.0.0.1:3000
UF_MAILPIT=1
UF_MAILPIT_URL=http://127.0.0.1:8025

# Lab mock OIDC + SMS HTTP sink (optional gated integ / host wiring):
# UF_MOCK_OIDC_URL=http://127.0.0.1:5556
# UF_SMS_SINK=1
# UF_SMS_SINK_URL=http://127.0.0.1:8099
# cargo run -p lepton-e2e --bin lepton-mock-oidc
# cargo run -p lepton-e2e --bin lepton-sms-sink

# Optional live Twilio (not used by default CI). Requires crate features:
#   lepton-smtp = { features = ["twilio"] }
#   lepton-sms  = { features = ["twilio"] }
# Email uses SendGrid Mail Send (API key), not SMS Account SID.
# UF_EMAIL_DRIVER=twilio
# UF_TWILIO_EMAIL_API_KEY=SG....
# UF_TWILIO_ACCOUNT_SID=AC....
# UF_TWILIO_API_KEY=SK....
# UF_TWILIO_API_SECRET=....
# Prefer Verify for OTP (enable Custom Verification Code on the service):
# UF_TWILIO_VERIFY_SERVICE_SID=VA....
# Messages fallback (A2P 10DLC) when Verify SID unset:
# UF_TWILIO_FROM=+15551234567
# Legacy SMS auth (often unavailable on new Twilio consoles):
# UF_TWILIO_AUTH_TOKEN=....
#
# Interactive signup → email → phone → confirm CLI (`lepton-e2e`):
# UF_LEPTON_LIVE_TWILIO=1
# UF_LIVE_VERIFY_LEGAL_NAME="Alex Rivera"
# UF_LIVE_VERIFY_EMAIL=you@example.com
# UF_LIVE_VERIFY_PHONE=+15551234567
# Generate a unique throwaway password per run — never reuse a real credential:
# UF_LIVE_VERIFY_PASSWORD="$(openssl rand -base64 18)Aa1!"
# UF_LIVE_VERIFY_SKIP_EMAIL=1   # optional: skip email send/paste; SMS only
# UF_LEPTON_LIVE_REVEAL_PII=1   # optional: print full email/phone (masked by default)
# cargo run -p lepton-e2e --bin lepton-live-verify --features live-twilio
#
# Interactive test user + Google Authenticator TOTP (no Twilio):
# UF_LEPTON_LIVE_TOTP=1
# UF_LIVE_VERIFY_LEGAL_NAME="Alex Rivera"
# UF_LIVE_VERIFY_EMAIL=you@example.com
# UF_LIVE_VERIFY_PHONE=+15555550199
# UF_LIVE_VERIFY_PASSWORD="$(openssl rand -base64 18)Aa1!"
# UF_LIVE_VERIFY_DEVICE_LABEL="Live TOTP Browser"   # optional
# UF_LIVE_VERIFY_TOTP_ISSUER="Acme Site"            # optional; CLI otpauth issuer
# UF_LEPTON_LIVE_REVEAL_SECRET=1                   # optional; print setup key (tty only)
# Product enroll issuer (Account Settings TOTP) uses UF_TOTP_ISSUER (default Unified Field):
# UF_TOTP_ISSUER="Acme Site"
# cargo run -p lepton-e2e --bin lepton-live-totp
#
# Interactive Google or GitHub OAuth signup + login (loopback callback; never CI):
# Register redirect URI http://127.0.0.1:8765/auth/oauth/callback on the OAuth app.
# UF_LEPTON_LIVE_OAUTH=1
# UF_OAUTH_PROVIDER=google                      # or github
# UF_OAUTH_GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# UF_OAUTH_GOOGLE_CLIENT_SECRET=....
# UF_OAUTH_GITHUB_CLIENT_ID=Iv1....
# UF_OAUTH_GITHUB_CLIENT_SECRET=....
# UF_PUBLIC_BASE_URL=http://127.0.0.1:8765
# UF_OAUTH_REDIRECT_PATH=/auth/oauth/callback   # optional
# UF_OAUTH_CALLBACK_PORT=8765                   # optional
# cargo run -p lepton-e2e --bin lepton-live-oauth --features live-oauth
